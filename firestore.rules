// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Fields:
//   - telegramId: string (required)
//   - username: string
//   - firstName: string (required)
//   - lastName: string
//   - joinedAt: timestamp (required)
//   - isBot: boolean
//
// Collection: invites
// Fields:
//   - inviterId: string (required)
//   - inviteeId: string (required)
//   - timestamp: timestamp (required)
//   - contestId: string (optional)
//
// Collection: leaves
// Fields:
//   - telegramId: string (required)
//   - timestamp: timestamp (required)
//
// Collection: contests
// Fields:
//   - title: string (required)
//   - startDate: timestamp (required)
//   - endDate: timestamp (required)
//   - prizes: string (required)
//   - isActive: boolean (required)
//   - imageUrl: string
//
// Collection: settings
// Fields:
//   - adminIds: list (required)
//   - welcomeMessage: string
//   - warningMessage: string
//   - contestTemplate: string
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
