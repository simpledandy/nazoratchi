{
  "entities": {
    "User": {
      "title": "User",
      "description": "Telegram user information",
      "type": "object",
      "properties": {
        "telegramId": { "type": "string" },
        "username": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "joinedAt": { "type": "string", "format": "date-time" },
        "isBot": { "type": "boolean" }
      },
      "required": ["telegramId", "firstName"]
    },
    "Invite": {
      "title": "Invite",
      "description": "Log of an invitation event",
      "type": "object",
      "properties": {
        "inviterId": { "type": "string" },
        "inviteeId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "contestId": { "type": "string" }
      },
      "required": ["inviterId", "inviteeId", "timestamp"]
    },
    "Leave": {
      "title": "Leave",
      "description": "Log of a member leaving the group",
      "type": "object",
      "properties": {
        "telegramId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["telegramId", "timestamp"]
    },
    "Contest": {
      "title": "Contest",
      "description": "Invitation contest configuration",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "prizes": { "type": "string" },
        "isActive": { "type": "boolean" },
        "imageUrl": { "type": "string" }
      },
      "required": ["title", "startDate", "endDate", "isActive"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Bot configuration and custom messages",
      "type": "object",
      "properties": {
        "adminIds": { "type": "array", "items": { "type": "string" } },
        "welcomeMessage": { "type": "string" },
        "warningMessage": { "type": "string" },
        "contestTemplate": { "type": "string" }
      }
    }
  },
  "firestore": {
    "users": { "schema": "User", "description": "Collection of group members" },
    "invites": { "schema": "Invite", "description": "Log of all invitations" },
    "leaves": { "schema": "Leave", "description": "Log of all leaves" },
    "contests": { "schema": "Contest", "description": "Contest configurations" },
    "settings": { "schema": "Settings", "description": "Global bot settings" }
  }
}
